<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # SEO: www.pixelax.fr -> pixelax.fr (avoid a duplicate copy of the site)
    RewriteCond %{HTTP_HOST} ^www\.pixelax\.fr$ [NC]
    RewriteRule ^(.*)$ https://pixelax.fr/$1 [R=301,L]

    # SEO: old wiki URL still linked from a past changelog entry
    RewriteRule ^wiki/pokemon-customs/pokemon-type-swap/?$ https://pixelax.fr/wiki/pokemon-type-swap [R=301,L]

    # Authorization header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # SEO: /public/... is an internal folder, never a public URL
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s/public(/|\s|\?)
    RewriteRule ^public/?(.*)$ /$1 [R=301,L]

    # Public assets fallback
    RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
    RewriteRule ^(.*)$ public/$1 [L]

    # Front controller
    # SECURITY: no "!-f" condition here. The web root is the whole application folder, so an
    # existing file without extension (storage/framework/cache/*, sessions, artisan...) used to be
    # served raw. Everything that is not a public asset now goes through Laravel (404 if unknown).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ server.php [L]
</IfModule>

# SECURITY: configuration files that must never be downloaded
<FilesMatch "^(web\.config|\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan|Dockerfile|docker-compose\.yml)$">
    Require all denied
</FilesMatch>

# --------------------------------------------------
# SECURITY HEADERS
# --------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"
    Header always set Strict-Transport-Security "max-age=15552000" "expr=%{HTTP:X-Forwarded-Proto} == 'https' || %{HTTPS} == 'on'"
    Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; upgrade-insecure-requests" "expr=%{HTTP:X-Forwarded-Proto} == 'https' || %{HTTPS} == 'on'"
    Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'" "expr=%{HTTP:X-Forwarded-Proto} != 'https' && %{HTTPS} != 'on'"
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # Anti-clickjacking only on sensitive pages (the public pages may be embedded, e.g. by the launcher)
    # (no backslash inside <If "...">: Apache strips them)
    <If "%{THE_REQUEST} =~ m#^[A-Z]+ /(admin|user|profile|shop/cart)#">
        Header always set X-Frame-Options "SAMEORIGIN"
    </If>
</IfModule>

# --------------------------------------------------
# COMPRESSION GZIP
# --------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml

    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|ico|webp)$ no-gzip dont-vary
</IfModule>

# --------------------------------------------------
# CACHE HEADERS (IMPORTANT FIX)
# --------------------------------------------------
<IfModule mod_headers.c>

    # ❌ HTML / pages dynamiques = PAS de cache
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # ⚡ API / JSON (si tu en as)
    <FilesMatch "\.(json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # 🚀 Assets statiques (versionnés recommandé)
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|ico|webp|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>

    # 🖼️ Images uploadées (/storage/...) : servies par PHP, donc cache autorisé explicitement
    # (sinon "no-store" ci-dessus empêche le cache navigateur et Cloudflare)
    # (pas d'antislash dans <If "..."> : Apache les retire à la lecture)
    <If "%{THE_REQUEST} =~ m#^(GET|HEAD) /storage/[^ ?]+[.](png|jpe?g|gif|webp|svg|ico|avif)([?][^ ]*)? #i">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400" "expr=%{REQUEST_STATUS} == 200"
        Header unset Pragma "expr=%{REQUEST_STATUS} == 200"
        Header unset Expires "expr=%{REQUEST_STATUS} == 200"
    </If>

</IfModule>

# --------------------------------------------------
# EXPIRES (optionnel mais propre)
# --------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Assets long terme
    ExpiresByType image/jpg "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"

    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"

    # HTML jamais cache
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --------------------------------------------------
# ETAG OFF (bon pour CDN/cache)
# --------------------------------------------------
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None
